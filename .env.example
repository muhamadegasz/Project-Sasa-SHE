DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=she_sasa
PORT=3001
# Wajib diisi nilai acak panjang untuk deployment sungguhan (mis. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
# Mengganti nilai ini akan membuat semua sesi login yang sedang aktif langsung tidak valid.
SESSION_SECRET=ganti-dengan-nilai-acak-panjang
# Origin frontend yang boleh memanggil API dengan cookie sesi (CORS). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://project-sasa-she.test
