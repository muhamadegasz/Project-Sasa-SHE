{
  "name": "she-sasa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SHE Sasa - Sistem Informasi K3. Backend Node.js/Express/MySQL (Phase 12+); frontend statis di index.html tetap berjalan tanpa backend (lihat docs/ROADMAP-PHASE12.md).",
  "scripts": {
    "server": "node --conditions=server server/listen.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "test:api": "node --conditions=server --test server/test/*.test.js",
    "test:unit": "node --conditions=test --test test/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "imports": {
    "#repositories/inspection-repository.js": {
      "test": "./test/fakes/inspection-repository.js",
      "server": "./server/repositories/inspection-repository.js",
      "default": "./src/repositories/inspection-repository.js"
    },
    "#repositories/schedule-repository.js": {
      "test": "./test/fakes/schedule-repository.js",
      "server": "./server/repositories/schedule-repository.js",
      "default": "./src/repositories/schedule-repository.js"
    },
    "#repositories/plant-repository.js": {
      "test": "./test/fakes/plant-repository.js",
      "server": "./server/repositories/plant-repository.js",
      "default": "./src/repositories/plant-repository.js"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "supertest": "^7.0.0"
  }
}
