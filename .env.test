# .env.test — Phase 17.4B.1: lingkungan PENGUJIAN OTOMATIS (npm run test:api, npm run test:e2e).
#
# Tidak berisi rahasia: kredensial DB dan SESSION_SECRET tetap dari .env.
# Nilai di sini dimuat LEBIH DULU (node --env-file / playwright.config.js),
# dan dotenv (.env) tidak pernah menimpa variabel yang sudah terisi — jadi
# pengujian selalu memakai database uji, sementara aplikasi pengembangan
# (npm run server) tetap memakai DB_NAME dari .env (she_sasa).
#
# server/db/seed.js MENOLAK mengosongkan database yang namanya tidak berakhiran _test.

DB_NAME=she_sasa_test

# Port backend uji yang dijalankan Playwright untuk E2E. Backend pengembangan
# tetap di PORT dari .env (3001) dan tidak disentuh pengujian.
E2E_API_PORT=3101
