                        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
                    },
                    "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                        "pm.test('status 401 INVALID_CREDENTIALS', () => {",
                        "  pm.response.to.have.status(401);",
                        "  pm.expect(pm.response.json().error).to.eql('INVALID_CREDENTIALS');",
                        "});"
                    ] } }]
                },
                {
                    "name": "Login sebagai Arif (Safety Officer) -> simpan csrfToken",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{ \"username\": \"arif\", \"password\": \"arif\" }" },
                        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
                    },
                    "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                        "pm.test('login berhasil, role benar', () => {",
                        "  pm.response.to.have.status(200);",
                        "  const body = pm.response.json();",
                        "  pm.expect(body.user.role).to.eql('safety_officer');",
                        "  pm.collectionVariables.set('csrfToken', body.csrfToken);",
                        "});"
                    ] } }]
                },
                {
                    "name": "GET /auth/me (pakai cookie sesi dari login)",
                    "request": {
                        "method": "GET",
                        "header": [],
