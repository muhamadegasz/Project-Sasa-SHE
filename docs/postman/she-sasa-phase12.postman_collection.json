                    },
                    "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                        "pm.test('status 200, displayName Arif', () => {",
                        "  pm.response.to.have.status(200);",
                        "  pm.expect(pm.response.json().user.displayName).to.eql('Arif');",
                        "});"
                    ] } }]
                },
                {
                    "name": "POST mengubah state TANPA header X-CSRF-Token -> 403 CSRF_INVALID",
                    "request": {
